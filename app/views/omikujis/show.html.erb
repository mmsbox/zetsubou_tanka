<div style="max-width: 600px; margin: 0 auto; padding: 20px; text-align: center; font-family: 'Shippori Mincho', serif;">
  <h1 style="font-size: 28px; color: #1a1a1a; border-bottom: 2px solid #8c1d1d; display: inline-block; padding-bottom: 6px; margin-bottom: 30px;">
    ⛩️ 本日の絶望おみくじ
  </h1>

  <!-- おみくじ結果カードエリア -->
  <div id="omikuji-card" style="background: #faf6ed; border: 3px double #d4c5b0; border-radius: 12px; padding: 30px 20px; box-shadow: 0 10px 25px rgba(0,0,0,0.15); margin-bottom: 30px; position: relative;">
    
    <% if @already_drawn %>
      <div style="font-size: 14px; color: #888; margin-bottom: 10px;">※ 本日は既におみくじを引いています</div>
    <% end %>

    <!-- 運勢ヘッダー -->
    <div style="font-size: 18px; color: #555; margin-bottom: 8px;">本日の運勢</div>
    <div style="font-size: 56px; font-weight: bold; color: <%= @fortune[:color] %>; letter-spacing: 4px; margin: 15px 0;">
      <%= @fortune[:result] %>
    </div>

    <!-- おみくじ短歌 -->
    <div style="background: #fff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 20px; margin: 20px 0; font-size: 20px; line-height: 1.8; color: #2d3748; letter-spacing: 2px;">
      <%= @fortune[:tanka] %>
    </div>

    <!-- 開発の助言 -->
    <div style="text-align: left; background: #f7fafc; border-left: 4px solid <%= @fortune[:color] %>; padding: 12px 16px; border-radius: 0 8px 8px 0; margin-top: 20px;">
      <div style="font-size: 12px; font-weight: bold; color: #718096; margin-bottom: 4px;">💡 絶望回避の助言</div>
      <div style="font-size: 14px; color: #2d3748;"><%= @fortune[:advice] %></div>
    </div>
  </div>

  <!-- シェア＆ナビゲーション -->
  <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
    <% 
      share_text = "【本日の絶望おみくじ】\n運勢：#{@fortune[:result]}\n#{@fortune[:tanka]}\n\n"
      share_url = omikuji_url
      hashtags = "絶望おみくじ,バトラン,RUNTEQ"
      twitter_url = "https://twitter.com/intent/tweet?text=#{CGI.escape(share_text)}&url=#{CGI.escape(share_url)}&hashtags=#{CGI.escape(hashtags)}"
    %>

    <%= link_to twitter_url, target: "_blank", rel: "noopener noreferrer", style: "padding: 12px 24px; background: #000; color: #fff; border-radius: 8px; text-decoration: none; font-weight: bold; display: flex; align-items: center; gap: 8px;" do %>
      <svg style="width: 16px; height: 16px; fill: currentColor;" viewBox="0 0 24 24">
        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
      </svg>
      おみくじ結果をXで呟く
    <% end %>

    <%= link_to "短歌を詠む", new_post_path, style: "padding: 12px 24px; background: #8c1d1d; color: #fff; border-radius: 8px; text-decoration: none; font-weight: bold;" %>
    <%= link_to "ギャラリーへ", posts_path, style: "padding: 12px 24px; background: #e2e8f0; color: #333; border-radius: 8px; text-decoration: none; font-weight: bold;" %>
  </div>
</div>
