<style>
  .btn-tanka {
    display: flex;
    align-items: center;
    justify-content: center;
    writing-mode: vertical-rl;
    text-orientation: upright;
    background: rgba(140, 29, 29, 0.92);
    color: #ffffff;
    font-family: 'Shippori Mincho', serif;
    font-size: 20px;
    font-weight: bold;
    letter-spacing: 0.2em;
    padding: 32px 16px;
    border: 2px solid #d4c5b0;
    border-radius: 8px;
    text-decoration: none;
    box-shadow: 0 8px 25px rgba(0,0,0,0.5);
    transition: all 0.25s ease;
  }
  .btn-tanka:hover {
    transform: translateY(-6px);
    background: #a62424;
  }

  .btn-gallery {
    display: flex;
    align-items: center;
    justify-content: center;
    writing-mode: vertical-rl;
    text-orientation: upright;
    background: rgba(26, 26, 26, 0.88);
    color: #d4c5b0;
    font-family: 'Shippori Mincho', serif;
    font-size: 18px;
    font-weight: bold;
    letter-spacing: 0.2em;
    padding: 32px 16px;
    border: 2px solid #555;
    border-radius: 8px;
    text-decoration: none;
    box-shadow: 0 8px 25px rgba(0,0,0,0.5);
    transition: all 0.25s ease;
  }
  .btn-gallery:hover {
    transform: translateY(-6px);
    border-color: #d4c5b0;
    color: #ffffff;
  }
</style>

<!-- TOPヒーローエリア (和風ファーストビュー) -->
<div style="
  position: relative;
  width: 100%;
  height: 88vh;
  min-height: 580px;
  background: #1a1a1a url('/bg.jpg') center/cover no-repeat;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: -20px;
  border-bottom: 3px solid #8c1d1d;
  box-shadow: inset 0 0 50px rgba(0,0,0,0.6);
  box-sizing: border-box;
">
  <!-- 黒グラデーションオーバーレイ -->
  <div style="
    position: absolute;
    inset: 0;
    background: radial-gradient(circle, rgba(0,0,0,0.25) 0%, rgba(0,0,0,0.75) 100%);
  "></div>

  <!-- メインレイアウト（ボタン群 ＆ ロゴ） -->
  <div style="
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 40px;
    height: 70%;
  ">

    <!-- 左側：ボタン2つ（横並び） -->
    <div style="display: flex; gap: 20px; align-items: center;">

      <!-- ボタン①：短歌を詠む -->
      <%= link_to new_post_path, class: "btn-tanka" do %>
        短歌を詠む
      <% end %>

      <!-- ボタン②：みんなのギャラリー -->
      <%= link_to posts_path, class: "btn-gallery" do %>
        みんなのギャラリー
      <% end %>

    </div>

    <!-- 右側：タイトルロゴ（縦書き 3行表示UI） -->
    <div style="
      background: rgba(250, 246, 237, 0.88);
      border: 3px solid #333;
      padding: 36px 28px;
      border-radius: 10px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.5);
      backdrop-filter: blur(4px);
    ">
      <h1 style="
        writing-mode: vertical-rl;
        text-orientation: upright;
        font-family: 'Shippori Mincho', serif;
        font-size: 38px;
        font-weight: 800;
        letter-spacing: 0.2em;
        color: #1a1a1a;
        margin: 0;
        line-height: 1.8;
      ">
        絶望<br>
        えらぁ<br>
        短歌
      </h1>
    </div>

  </div>
</div>
