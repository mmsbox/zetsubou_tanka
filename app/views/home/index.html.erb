<style>
  /* 全体コンテナの幅制限解除 */
  main {
    max-width: 100% !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  /* ボタン共通スタイル */
  .btn-tanka, .btn-gallery {
    display: flex;
    align-items: center;
    justify-content: center;
    writing-mode: vertical-rl;
    text-orientation: upright;
    font-family: 'Shippori Mincho', serif;
    border-radius: 8px;
    text-decoration: none;
    box-shadow: 0 8px 25px rgba(0,0,0,0.6);
    transition: all 0.25s ease;
    box-sizing: border-box;
  }

  .btn-tanka {
    background: rgba(140, 29, 29, 0.92);
    color: #ffffff;
    font-size: 20px;
    font-weight: bold;
    letter-spacing: 0.2em;
    padding: 32px 16px;
    border: 2px solid #d4c5b0;
  }
  .btn-tanka:hover {
    transform: translateY(-6px);
    background: #a62424;
  }

  .btn-gallery {
    background: rgba(26, 26, 26, 0.88);
    color: #d4c5b0;
    font-size: 18px;
    font-weight: bold;
    letter-spacing: 0.2em;
    padding: 32px 16px;
    border: 2px solid #555;
  }
  .btn-gallery:hover {
    transform: translateY(-6px);
    border-color: #d4c5b0;
    color: #ffffff;
  }

  /* 📱 スマホ用スタイル調整（画面幅768px以下の場合） */
  @media (max-width: 768px) {
    .hero-layout {
      flex-direction: column-reverse !important;
      gap: 24px !important;
      height: auto !important;
      padding: 40px 16px !important;
    }

    .hero-logo-img {
      max-height: 240px !important;
      width: auto !important;
    }

    .btn-container {
      gap: 12px !important;
    }

    .btn-tanka, .btn-gallery {
      font-size: 16px !important;
      padding: 20px 12px !important;
    }
  }
</style>

<!-- TOPヒーローエリア (全画面和風ファーストビュー) -->
<div style="
  position: relative;
  width: 100%;
  min-height: calc(100vh - 60px);
  background: #1a1a1a url('/bg.jpg') center/cover no-repeat;
  display: flex;
  justify-content: center;
  align-items: center;
  box-sizing: border-box;
  overflow: hidden;
">
  <!-- 黒グラデーションオーバーレイ -->
  <div style="
    position: absolute;
    inset: 0;
    background: radial-gradient(circle, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.7) 100%);
  "></div>

  <!-- メインレイアウト -->
  <div class="hero-layout" style="
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 50px;
    height: 80%;
    width: 100%;
  ">

    <!-- 左側：ボタン2つ -->
    <div class="btn-container" style="display: flex; gap: 20px; align-items: center;">
      <%= link_to new_post_path, class: "btn-tanka" do %>
        短歌を詠む
      <% end %>

      <%= link_to posts_path, class: "btn-gallery" do %>
        みんなのギャラリー
      <% end %>
    </div>

    <!-- 右側：ロゴ画像 -->
    <div style="display: flex; align-items: center; justify-content: center;">
      <img src="/logo.png" alt="絶望えらぁ短歌" class="hero-logo-img" style="
        max-height: 480px;
        width: auto;
        filter: drop-shadow(0 10px 25px rgba(0,0,0,0.8));
      ">
    </div>

  </div>
</div>
