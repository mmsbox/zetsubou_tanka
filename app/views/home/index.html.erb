<style>
  /* 縦書き共通スタイル */
  .btn-omikuji, .btn-tanka, .btn-gallery {
    writing-mode: vertical-rl;
    text-orientation: upright;
    text-decoration: none;
    border-radius: 8px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.5);
    transition: all 0.3s ease;
    display: flex;
    justify-content: center;
    align-items: center;
    box-sizing: border-box;
  }

  /* ⛩️ おみくじボタン */
  .btn-omikuji {
    background: rgba(140, 29, 29, 0.95);
    color: #ffffff;
    font-size: 19px;
    font-weight: bold;
    letter-spacing: 0.2em;
    padding: 32px 16px;
    border: 2px solid #ff4d4d;
  }
  .btn-omikuji:hover {
    transform: translateY(-6px);
    background: #b32424;
    box-shadow: 0 15px 30px rgba(140, 29, 29, 0.8);
  }

  /* ✍️ 短歌を詠むボタン */
  .btn-tanka {
    background: rgba(30, 30, 30, 0.92);
    color: #ffffff;
    font-size: 19px;
    font-weight: bold;
    letter-spacing: 0.2em;
    padding: 32px 16px;
    border: 2px solid #d4c5b0;
  }
  .btn-tanka:hover {
    transform: translateY(-6px);
    background: #333333;
    border-color: #ffffff;
  }

  /* 🖼️ ギャラリーボタン */
  .btn-gallery {
    background: rgba(15, 15, 15, 0.88);
    color: #d4c5b0;
    font-size: 18px;
    font-weight: bold;
    letter-spacing: 0.2em;
    padding: 32px 16px;
    border: 2px solid #555;
  }
  .btn-gallery:hover {
    transform: translateY(-6px);
    border-color: #d4c5b0;
    color: #ffffff;
  }

  /* 📱 スマホ用スタイル調整 */
  @media (max-width: 768px) {
    .hero-layout {
      flex-direction: column-reverse !important;
      gap: 24px !important;
      height: auto !important;
      padding: 40px 16px !important;
    }

    .hero-logo-img {
      max-height: 220px !important;
      width: auto !important;
    }

    .btn-container {
      gap: 10px !important;
    }

    .btn-tanka, .btn-gallery, .btn-omikuji {
      font-size: 15px !important;
      padding: 20px 10px !important;
    }
  }
</style>

<!-- TOPヒーローエリア (全画面和風ファーストビュー・固定表示版) -->
<div style="
  position: fixed;
  top: 60px;
  left: 0;
  width: 100vw;
  height: calc(100vh - 60px);
  background: #1a1a1a url('/bg.jpg') center/cover no-repeat;
  display: flex;
  justify-content: center;
  align-items: center;
  box-sizing: border-box;
  overflow: hidden;
  z-index: 1;
">
  <!-- 黒グラデーションオーバーレイ -->
  <div style="
    position: absolute;
    inset: 0;
    background: radial-gradient(circle, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.7) 100%);
  "></div>

  <!-- メインレイアウト -->
  <div class="hero-layout" style="
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 40px;
    height: 100%;
    width: 100%;
    max-width: 1200px;
    padding: 0 20px;
    box-sizing: border-box;
  ">

    <!-- 左側：縦書きボタン3つ -->
    <div class="btn-container" style="display: flex; gap: 16px; align-items: center;">
      <%= link_to omikuji_path, class: "btn-omikuji" do %>
        本日の絶望おみくじ
      <% end %>

      <%= link_to new_post_path, class: "btn-tanka" do %>
        短歌を詠む
      <% end %>

      <%= link_to posts_path, class: "btn-gallery" do %>
        みんなのギャラリー
      <% end %>
    </div>

    <!-- 右側：ロゴ画像 -->
    <div style="display: flex; align-items: center; justify-content: center;">
      <img src="/logo.png" alt="絶望えらぁ短歌" class="hero-logo-img" style="
        max-height: 480px;
        width: auto;
        filter: drop-shadow(0 10px 25px rgba(0,0,0,0.8));
      ">
    </div>
  </div>
</div>
