<div style="max-width: 800px; margin: 60px auto; text-align: center; padding: 20px; font-family: sans-serif;">
  
  <!-- 縦書き風タイトルエリア（ラフ画像2） -->
  <div style="margin-bottom: 50px;">
    <h1 style="writing-mode: vertical-rl; text-orientation: upright; margin: 0 auto; font-size: 48px; letter-spacing: 8px; height: 260px; font-family: 'serif'; color: #2c3e50;">
      絶望えらあ短歌
    </h1>
    <p style="color: #666; margin-top: 20px;">〜 エラーの悲しみを、五七五七七にのせて 〜</p>
  </div>

  <!-- ナビゲーションボタン（ラフ画像2） -->
  <div style="display: flex; gap: 20px; justify-content: center; align-items: center; flex-wrap: wrap;">
    <%= link_to "短歌を詠む", new_post_path, style: "padding: 16px 36px; background: #2563eb; color: white; border-radius: 30px; text-decoration: none; font-size: 20px; font-weight: bold; box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);" %>
    
    <%= link_to "みんなのギャラリーへ", posts_path, style: "padding: 16px 36px; background: #f3f4f6; color: #374151; border-radius: 30px; text-decoration: none; font-size: 18px; font-weight: bold; border: 1px solid #d1d5db;" %>
  </div>

</div>
