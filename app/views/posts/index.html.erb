<!-- 画面全域を隙間なく覆う固定ダーク背景ラッパー -->
<div style="
  position: fixed;
  top: 60px;
  left: 0;
  width: 100vw;
  height: calc(100vh - 60px);
  background: radial-gradient(circle at center, #230d0d 0%, #0d0808 70%, #050303 100%);
  z-index: 0;
  overflow-y: auto;
  overflow-x: hidden;
  box-sizing: border-box;
  font-family: 'Shippori Mincho', serif;
  color: #f0e6d2;
  padding: 30px 0 60px 0;
">
  <div style="min-height: 100%; display: flex; flex-direction: column; justify-content: space-between;">
    
    <!-- ヘッダーエリア -->
    <div style="text-align: center; margin-bottom: 25px; padding: 0 16px;">
      <h1 style="
        font-size: 32px;
        color: #f5e6c8;
        text-shadow: 0 0 12px rgba(140, 29, 29, 0.8), 0 2px 4px #000;
        border-bottom: 2px solid #8c1d1d;
        display: inline-block;
        padding-bottom: 8px;
        margin: 0 0 10px 0;
        letter-spacing: 0.15em;
      ">
        🎏 絶望短歌 展覧会
      </h1>
      <p style="font-size: 13px; color: #a39382; margin: 0 0 20px 0; letter-spacing: 0.08em;">
        世のエンジニアたちが詠みし 悲痛なる短歌の数々（左右にスクロールできます）
      </p>

      <!-- ソートタブ -->
      <div style="display: flex; justify-content: center; gap: 12px;">
        <%= link_to posts_path(sort: "latest"), data: { turbo: false }, style: "
          padding: 8px 20px;
          border-radius: 20px;
          text-decoration: none;
          font-size: 14px;
          font-weight: bold;
          transition: all 0.3s ease;
          #{@sort == 'likes' ? 'background: rgba(255,255,255,0.05); color: #887868; border: 1px solid #443535;' : 'background: #8c1d1d; color: #fff; border: 1px solid #b32424; box-shadow: 0 0 12px rgba(140, 29, 29, 0.6);'}
        " do %>
          🌸 新着順
        <% end %>

        <%= link_to posts_path(sort: "likes"), data: { turbo: false }, style: "
          padding: 8px 20px;
          border-radius: 20px;
          text-decoration: none;
          font-size: 14px;
          font-weight: bold;
          transition: all 0.3s ease;
          #{@sort == 'likes' ? 'background: #8c1d1d; color: #fff; border: 1px solid #b32424; box-shadow: 0 0 12px rgba(140, 29, 29, 0.6);' : 'background: rgba(255,255,255,0.05); color: #887868; border: 1px solid #443535;'}
        " do %>
          🔥 共感順 (人気)
        <% end %>
      </div>
    </div>

    <!-- 画面横いっぱいに広がる全画面横スクロールエリア -->
    <div class="gallery-scroll-container" style="
      width: 100vw;
      overflow-x: auto;
      overflow-y: hidden;
      padding: 20px 40px 30px 40px;
      box-sizing: border-box;
      display: flex;
      gap: 24px;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
    ">
      <% if @posts.any? %>
        <% @posts.each do |post| %>
          <div class="gallery-card-wrapper" style="scroll-snap-align: start; flex: 0 0 auto; transition: transform 0.3s ease;">
            <%= render 'posts/tanka_card', post: post %>
          </div>
        <% end %>
      <% else %>
        <div style="width: 100vw; text-align: center; padding: 60px 0; color: #a39382;">
          まだ短歌が詠まれておりません。第一号を詠んでみませんか？
        </div>
      <% end %>
    </div>

    <!-- 投稿ボタン -->
    <div style="text-align: center; margin-top: 20px;">
      <%= link_to "自分も短歌を詠む 🔥", new_post_path, style: "
        display: inline-block;
        padding: 14px 32px;
        background: linear-gradient(135deg, #8c1d1d 0%, #571010 100%);
        color: #ffffff;
        font-size: 16px;
        font-weight: bold;
        font-family: 'Shippori Mincho', serif;
        border: 1px solid #b32424;
        border-radius: 30px;
        text-decoration: none;
        box-shadow: 0 6px 20px rgba(140, 29, 29, 0.6);
        transition: transform 0.2s ease;
      " %>
    </div>

  </div>
</div>

<!-- スクロールバー装飾＆ホバー効果 -->
<style>
  /* 横スクロールバーを黒×赤の和風デザインに */
  .gallery-scroll-container::-webkit-scrollbar {
    height: 10px;
  }
  .gallery-scroll-container::-webkit-scrollbar-track {
    background: #0d0808;
    border-radius: 5px;
    margin: 0 40px;
  }
  .gallery-scroll-container::-webkit-scrollbar-thumb {
    background: #571c1c;
    border-radius: 5px;
    border: 1px solid #8c1d1d;
  }
  .gallery-scroll-container::-webkit-scrollbar-thumb:hover {
    background: #8c1d1d;
  }

  /* カードホバー時の効果 */
  .gallery-card-wrapper:hover {
    transform: translateY(-6px);
  }
</style>

<script>
  function setupGalleryLikes() {
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;

    document.querySelectorAll(".gallery-like-btn").forEach(btn => {
      if (btn.dataset.initialized) return;
      btn.dataset.initialized = "true";

      btn.addEventListener("click", function(e) {
        e.preventDefault();
        e.stopPropagation();

        const postId = this.dataset.postId;
        const countSpan = document.querySelector(`.like-count-${postId}`);

        if (countSpan) {
          let currentCount = parseInt(countSpan.textContent, 10) || 0;
          countSpan.textContent = currentCount + 1;
        }

        fetch(`/posts/${postId}/like`, {
          method: 'POST',
          headers: {
            'X-CSRF-Token': csrfToken,
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          }
        })
        .then(response => {
          if (!response.ok) throw new Error('ネットワーク応答エラー');
          return response.json();
        })
        .then(data => {
          if (data.likes_count !== undefined && countSpan) {
            countSpan.textContent = data.likes_count;
          }
        })
        .catch(err => {
          console.error("Like Error:", err);
          if (countSpan) {
            let currentCount = parseInt(countSpan.textContent, 10) || 1;
            countSpan.textContent = Math.max(0, currentCount - 1);
          }
        });
      });
    });
  }

  document.addEventListener("turbo:load", setupGalleryLikes);
  document.addEventListener("DOMContentLoaded", setupGalleryLikes);
</script>
