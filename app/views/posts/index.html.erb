<!-- 画面全域を覆う固定ダーク背景ラッパー -->
<div style="
  position: fixed;
  top: 60px;
  left: 0;
  width: 100vw;
  height: calc(100vh - 60px);
  background: radial-gradient(circle at center, #230d0d 0%, #0d0808 70%, #050303 100%);
  z-index: 10;
  overflow-y: auto;
  overflow-x: hidden;
  box-sizing: border-box;
  font-family: 'Shippori Mincho', serif;
  color: #f0e6d2;
  padding: 40px 16px 100px 16px;
">
  <div style="max-width: 900px; margin: 0 auto;">
    
    <!-- ヘッダーエリア -->
    <div style="text-align: center; margin-bottom: 50px;">
      <h1 style="
        font-size: 32px;
        color: #f5e6c8;
        text-shadow: 0 0 12px rgba(140, 29, 29, 0.8), 0 2px 4px #000;
        border-bottom: 2px solid #8c1d1d;
        display: inline-block;
        padding-bottom: 8px;
        margin: 0 0 10px 0;
        letter-spacing: 0.15em;
      ">
        🏛️ 絶望えらぁ短歌 展覧会
      </h1>
      <p style="font-size: 13px; color: #a39382; margin: 0 0 20px 0; letter-spacing: 0.08em;">
        世のエンジニアたちが詠みし 悲痛なる短歌の数々
      </p>

      <!-- ソートタブ -->
      <div style="display: flex; justify-content: center; gap: 12px;">
        <%= link_to posts_path(sort: "latest"), data: { turbo: false }, style: "
          padding: 8px 20px;
          border-radius: 20px;
          text-decoration: none;
          font-size: 14px;
          font-weight: bold;
          transition: all 0.3s ease;
          #{@sort == 'likes' ? 'background: rgba(255,255,255,0.05); color: #887868; border: 1px solid #443535;' : 'background: #8c1d1d; color: #fff; border: 1px solid #b32424; box-shadow: 0 0 12px rgba(140, 29, 29, 0.6);'}
        " do %>
          🌸 新着順
        <% end %>

        <%= link_to posts_path(sort: "likes"), data: { turbo: false }, style: "
          padding: 8px 20px;
          border-radius: 20px;
          text-decoration: none;
          font-size: 14px;
          font-weight: bold;
          transition: all 0.3s ease;
          #{@sort == 'likes' ? 'background: #8c1d1d; color: #fff; border: 1px solid #b32424; box-shadow: 0 0 12px rgba(140, 29, 29, 0.6);' : 'background: rgba(255,255,255,0.05); color: #887868; border: 1px solid #443535;'}
        " do %>
          🔥 共感順 (人気)
        <% end %>
      </div>
    </div>

    <!-- 縦スクロール ＆ 交互斜め短冊レイアウト -->
    <div class="tanka-gallery-vertical">
      <% if @posts.any? %>
        <% @posts.each_with_index do |post, idx| %>
          <div class="tanka-item-wrapper <%= idx.odd? ? 'odd-card' : 'even-card' %>">
            
            <!-- 短歌和紙カード -->
            <div class="tanka-card-inner" style="
              background: radial-gradient(circle, #fcf8f2 0%, #f3ece0 100%);
              border: 2px solid #c8b9a6;
              border-radius: 12px;
              padding: 86px 16px;
              width: 100%;
              max-width: 300px;
              box-sizing: border-box;
              position: relative;
              color: #2c221e;
            ">
              
              <!-- 詠み手（名前） -->
              <div style="font-size: 13px; color: #7a6b5d; font-weight: bold; border-bottom: 1px dashed #d4c5b0; padding-bottom: 8px; margin-bottom: 18px; display: flex; justify-content: space-between; align-items: center;">
                <span>詠み手：<%= post.author_name.presence || "名無し法師" %></span>
                <span style="font-size: 11px; color: #a09080;"><%= post.created_at.strftime("%Y/%m/%d") %></span>
              </div>

              <!-- 短歌本文（5・7・5・7・7改行 / post.body に対応） -->
            <!-- 短歌本文（和風縦書き表示） -->
              <div style="
                width: 100%;
                height: 220px;
                display: flex;
                justify-content: center;
                align-items: center;
                margin-bottom: 18px;
                overflow: hidden;
              ">
                <div style="
                  writing-mode: vertical-rl;
                  -webkit-writing-mode: vertical-rl;
                  text-orientation: upright;
                  -webkit-text-orientation: upright;
                  font-size: 18px;
                  line-height: 2.0;
                  letter-spacing: 0.2em;
                  color: #1a1008;
                  font-weight: 500;
                  height: 200px;
                  max-width: 280px;
                  word-break: break-all;
                  font-family: 'Yuji Syuku', 'Shippori Mincho', serif;
                ">
                  <%= sanitize post.tanka.to_s.gsub(/[  ]+/, '<br>'), tags: %w[br] %>
                </div>
              </div>
              <!-- カードフッター（共感ボタン・詳細リンク） -->
              <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #e2d7c7; padding-top: 12px; margin-top: 10px;">
                <button class="gallery-like-btn" data-post-id="<%= post.id %>" style="
                  background: none;
                  border: 1px solid #b32424;
                  border-radius: 20px;
                  color: #8c1d1d;
                  padding: 4px 14px;
                  font-size: 13px;
                  font-weight: bold;
                  cursor: pointer;
                  display: flex;
                  align-items: center;
                  gap: 6px;
                  transition: all 0.2s;
                ">
                  <span>🙏 共感</span>
                  <span class="like-count-<%= post.id %>"><%= post.likes_count || 0 %></span>
                </button>

                <%= link_to "鑑賞する →", post_path(post), onclick: "showLoading('作品を鑑賞中…')", style: "font-size: 13px; color: #8c1d1d; text-decoration: none; font-weight: bold;" %>
              </div>

            </div>
          </div>
        <% end %>
      <% else %>
        <div style="text-align: center; padding: 60px 0; color: #a39382;">
          まだ短歌が詠まれておりません。第一号を詠んでみませんか？
        </div>
      <% end %>
    </div>

    <!-- 投稿ボタン -->
    <div style="text-align: center; margin-top: 60px;">
      <%= link_to "自分も短歌を詠む 🔥", new_post_path, onclick: "showLoading('案内中…')", style: "
        display: inline-block;
        padding: 14px 36px;
        background: linear-gradient(135deg, #8c1d1d 0%, #571010 100%);
        color: #fff;
        font-size: 16px;
        font-weight: bold;
        border-radius: 30px;
        text-decoration: none;
        box-shadow: 0 6px 20px rgba(140, 29, 29, 0.6);
        transition: transform 0.2s ease;
      " %>
    </div>

  </div>
</div>

<!-- CSSスタイル -->
<style>
  .tanka-gallery-vertical {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding: 10px;
  }

  .tanka-item-wrapper {
    display: flex;
    width: 100%;
    transition: transform 0.4s ease, filter 0.4s ease;
  }

  .odd-card {
    justify-content: flex-start;
    padding-left: 15%;
  }
  .odd-card .tanka-card-inner {
    transform: rotate(-3.5deg);
  }

  .even-card {
    justify-content: flex-end;
    padding-right: 5%;
  }
  .even-card .tanka-card-inner {
    transform: rotate(3.5deg);
  }

  .tanka-card-inner {
    transition: transform 0.3s ease, filter 0.3s ease;
    filter: drop-shadow(0 10px 15px rgba(0,0,0,0.8));
  }

  .tanka-card-inner:hover {
    transform: rotate(0deg) scale(1.05) !important;
    filter: drop-shadow(0 0 20px rgba(140, 29, 29, 0.8)) !important;
    z-index: 10;
  }

  @media (max-width: 600px) {
    .odd-card, .even-card {
      justify-content: center;
      padding: 0;
    }
    .odd-card .tanka-card-inner {
      transform: rotate(-2deg);
    }
    .even-card .tanka-card-inner {
      transform: rotate(2deg);
    }
  }
</style>

<!-- JavaScript -->
<script>
  function setupGalleryLikes() {
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;

    document.querySelectorAll(".gallery-like-btn").forEach(btn => {
      if (btn.dataset.initialized) return;
      btn.dataset.initialized = "true";

      btn.addEventListener("click", function(e) {
        e.preventDefault();
        e.stopPropagation();

        const postId = this.dataset.postId;
        const countSpan = document.querySelector(`.like-count-${postId}`);

        if (countSpan) {
          let currentCount = parseInt(countSpan.textContent, 10) || 0;
          countSpan.textContent = currentCount + 1;
        }

        fetch(`/posts/${postId}/like`, {
          method: 'POST',
          headers: {
            'X-CSRF-Token': csrfToken,
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          }
        })
        .then(response => {
          if (!response.ok) throw new Error('ネットワーク応答エラー');
          return response.json();
        })
        .then(data => {
          if (data.likes_count !== undefined && countSpan) {
            countSpan.textContent = data.likes_count;
          }
        })
        .catch(err => {
          console.error("Like Error:", err);
          if (countSpan) {
            let currentCount = parseInt(countSpan.textContent, 10) || 1;
            countSpan.textContent = Math.max(0, currentCount - 1);
          }
        });
      });
    });
  }

  document.addEventListener("turbo:load", setupGalleryLikes);
  document.addEventListener("DOMContentLoaded", setupGalleryLikes);
</script>
