<!-- 画面全体の最外枠 -->
<div
  style="width: 100%; min-height: calc(100vh - 60px); background: radial-gradient(circle at center, #230d0d 0%, #0d0808 70%, #050303 100%); padding: 40px 16px 80px; box-sizing: border-box; font-family: 'Shippori Mincho', serif; position: relative;"
>
  <div style="max-width: 600px; margin: 0 auto; position: relative; z-index: 1;">
    <!-- タイトルエリア -->
    <div style="text-align: center; margin-bottom: 24px;">
      <h1
        style="font-size: 26px; color: #f2e8d8; border-bottom: 2px solid #8c1d1d; display: inline-block; padding-bottom: 8px; margin-bottom: 12px; font-weight: 800;"
      >
        <% if @parent_post.present? %>
          ✉️ 返歌（アンサー短歌）を詠む
        <% else %>
          🔥 絶望の短歌を詠む
        <% end %>
      </h1>
      <p style="font-size: 14px; color: #a39382; margin: 0;">
        <% if @parent_post.present? %>
          寄り添う歌や、さらなる絶望の共鳴を言葉に乗せてくだされ
        <% else %>
          エラーの悲痛なる叫びを五・七・五・七・七の響きに変換いたします
        <% end %>
      </p>
    </div>

    <!-- 返歌対象の親短歌プレビュー表示 -->
    <% if @parent_post.present? %>
      <div
        style="background: #150f14; border: 1px solid #8c1d72; border-radius: 8px; padding: 16px 20px; margin-bottom: 24px; color: #f2e8d8;"
      >
        <div style="font-size: 12px; color: #ff79c6; font-weight: bold; margin-bottom: 6px;">
          【返歌先の短歌】
        </div>
        <div style="font-size: 15px; font-weight: 600; line-height: 1.6; color: #f0e6d2;">
          <%= @parent_post.tanka %>
        </div>
        <div style="font-size: 12px; color: #a39585; text-align: right; margin-top: 6px;">
          詠み手：<%= @parent_post.author_name.presence || "名無し法師" %>
        </div>
      </div>
    <% end %>

    <!-- 入力フォームエリア（ダーク和風カード） -->
    <div
      style="background: #1a1512; border: 1px solid #3a2e2b; border-radius: 12px; padding: 30px 24px; box-shadow: 0 10px 30px rgba(0,0,0,0.7), 0 0 20px rgba(140, 29, 29, 0.3); box-sizing: border-box;"
    >
      <%= form_with(model: @post, local: true) do |f| %>
        <!-- parent_id を送信するための隠しフィールド -->
        <%= f.hidden_field :parent_id %>

        <!-- 🔮 モード選択（ラジオボタンタブ） -->
        <div
          style="margin-bottom: 24px; display: flex; gap: 12px; background: #0d0808; padding: 6px; border-radius: 30px; border: 1px solid #3a2e2b;"
        >
          <label style="flex: 1; text-align: center; cursor: pointer; margin: 0;">
            <input
              type="radio"
              name="mode"
              value="ai"
              id="mode-ai"
              checked
              style="display: none;"
            >
            <div
              class="mode-tab-btn active"
              id="tab-ai"
              style="padding: 10px 14px; border-radius: 20px; font-size: 14px; font-weight: bold; transition: all 0.2s ease;"
            >
              🤖 AIに短歌を詠ませる
            </div>
          </label>
          <label style="flex: 1; text-align: center; cursor: pointer; margin: 0;">
            <input
              type="radio"
              name="mode"
              value="manual"
              id="mode-manual"
              style="display: none;"
            >
            <div
              class="mode-tab-btn"
              id="tab-manual"
              style="padding: 10px 14px; border-radius: 20px; font-size: 14px; font-weight: bold; transition: all 0.2s ease;"
            >
              ✍️ 自分で自作短歌を詠む
            </div>
          </label>
        </div>

        <!-- ① AIモード用：エラーメッセージ（入力必須） -->
        <div id="ai-input-group" style="margin-bottom: 24px;">
          <%= f.label :error_message,
                      (@parent_post.present? ? "返歌に込める絶望 / メッセージ" : "絶望のエラーメッセージ / 悲鳴"),
                      style: "display: block; font-weight: bold; margin-bottom: 8px; color: #d4c5b0; font-size: 15px;" %>
          <%= f.text_area :error_message,
                          id: "ai-error-textarea",
                          rows: 5,
                          required: true,
                          placeholder: (@parent_post.present? ? "例: その気持ち、痛いほどわかる...（共感や返歌の想いを入力）" : "例: NoMethodError: undefined method 'user=' for nil:NilClass\n（怒りや悲しみの叫びでも可）"),
                          style: "width: 100%; padding: 12px; border: 1px solid #5a4a3e; border-radius: 8px; background: #0d0808; color: #f2e8d8; font-size: 14px; box-sizing: border-box; font-family: monospace; resize: vertical; line-height: 1.5;" %>
        </div>

        <!-- ② 自分で詠むモード用：短歌直接入力 ＋ 任意のエラーログ -->
        <div id="manual-input-group" style="display: none; margin-bottom: 24px;">
          <div style="margin-bottom: 20px;">
            <%= f.label :tanka,
                        "短歌本文（五・七・五・七・七）",
                        style: "display: block; font-weight: bold; margin-bottom: 8px; color: #d4c5b0; font-size: 15px;" %>
            <%= f.text_field :tanka,
                             id: "manual-tanka-input",
                             placeholder: "例: 立ち上がれ ぬるの呪いよ 永久に消えよ",
                             style: "width: 100%; padding: 12px; border: 1px solid #5a4a3e; border-radius: 8px; background: #0d0808; color: #f2e8d8; font-size: 15px; box-sizing: border-box;" %>
            <span style="font-size: 12px; color: #a39382; margin-top: 4px; display: block;">※スペースで区切ると読みやすくなります</span>
          </div>

          <div>
            <%= f.label :error_message_manual,
                        "添えるエラーメッセージ / ログ（任意）",
                        style: "display: block; font-weight: bold; margin-bottom: 8px; color: #d4c5b0; font-size: 14px;" %>
            <textarea
              id="manual-error-textarea"
              rows="3"
              placeholder="カード下部に表示するエラーコード（空欄可）"
              style="width: 100%; padding: 10px; border: 1px solid #5a4a3e; border-radius: 8px; background: #0d0808; color: #f2e8d8; font-size: 13px; box-sizing: border-box; font-family: monospace; resize: vertical;"
            ></textarea>
          </div>
        </div>

        <!-- 🏷️ エラー種別・タグ（選択または自由入力） -->
        <div style="margin-bottom: 24px;">
          <%= f.label :error_category, "🏷️ エラー種別・タグ（RUNTEQ生活・エラー種別・自由入力）", style: "display: block; font-weight: bold; margin-bottom: 8px; color: #d4c5b0; font-size: 15px;" %>
          <%= f.text_field :error_category, list: "category-list", placeholder: "例: カリキュラム詰まり, Docker環境構築, SyntaxError など",
                           style: "width: 100%; padding: 12px; border: 1px solid #5a4a3e; border-radius: 8px; background: #0d0808; color: #f2e8d8; font-size: 14px; box-sizing: border-box;" %>
          
          <datalist id="category-list">
            <% if defined?(Post::CATEGORY_GROUPS) %>
              <% Post::CATEGORY_GROUPS.each do |group_name, tags| %>
                <% tags.each do |cat| %>
                  <option value="<%= cat %>"><%= group_name %></option>
                <% end %>
              <% end %>
            <% elsif defined?(Post::ALL_CATEGORIES) %>
              <% Post::ALL_CATEGORIES.each do |cat| %>
                <option value="<%= cat %>"></option>
              <% end %>
            <% end %>
          </datalist>
        </div>

        <!-- 詠み手（名前・任意） -->
        <div style="margin-bottom: 30px;">
          <%= f.label :author_name,
                      "詠み手（お名前 / 雅号）",
                      style: "display: block; font-weight: bold; margin-bottom: 8px; color: #d4c5b0; font-size: 15px;" %>
          <%= f.text_field :author_name,
                           placeholder: "例: 迷えるエンジニア（空欄の場合は「名無し法師」）",
                           style: "width: 100%; padding: 12px; border: 1px solid #5a4a3e; border-radius: 8px; background: #0d0808; color: #f2e8d8; font-size: 14px; box-sizing: border-box;" %>
        </div>

        <!-- 送信ボタン -->
        <div style="text-align: center;">
          <%= f.submit (@parent_post.present? ? "返歌を詠む ✉️" : "短歌を詠む 🔥"),
                       id: "tanka-submit-btn",
                       style: "width: 100%; padding: 14px; background: linear-gradient(135deg, #8c1d1d, #571010); color: #fff; font-size: 16px; font-weight: bold; font-family: 'Shippori Mincho', serif; border: none; border-radius: 30px; cursor: pointer; box-shadow: 0 4px 15px rgba(140, 29, 29, 0.6); transition: all 0.2s ease;" %>
        </div>
      <% end %>
    </div>

    <!-- 戻るリンク -->
    <div style="text-align: center; margin-top: 24px;">
      <%= link_to "← TOPへもどる",
                  root_path,
                  style: "color: #a39382; text-decoration: none; font-size: 14px; font-weight: bold;" %>
    </div>
  </div>
</div>

<!-- 🎃 短歌生成専用・全画面怨念ローディング画面（画面内に直接配置） -->
<div
  id="post-loading-overlay"
  style="display: none; position: fixed; inset: 0; width: 100vw; height: 100vh; background: radial-gradient(circle at center, #1a0808 0%, #080303 80%, #000000 100%); z-index: 999999; flex-direction: column; justify-content: center; align-items: center; font-family: 'Shippori Mincho', serif; color: #f0e6d2;"
>
  <!-- 妖しく回転する呪印 -->
  <div class="post-loading-circle"></div>
  <!-- 中央のテキストエリア -->
  <div style="position: relative; z-index: 2; text-align: center; padding: 0 20px;">
    <p
      id="post-loading-text"
      style="font-size: 22px; letter-spacing: 0.2em; color: #f5e6c8; text-shadow: 0 0 12px rgba(140, 29, 29, 0.9), 0 0 20px #8c1d1d; margin-bottom: 16px; min-height: 32px;"
    >
      絶望の短歌を詠み上げております…
    </p>
    <p style="font-size: 13px; color: #887868; letter-spacing: 0.1em;">
      しばしお待ちくだされ
    </p>
  </div>
</div>

<style>
  .mode-tab-btn {
    color: #a39382;
    background: transparent;
  }
  .mode-tab-btn.active {
    color: #ffffff;
    background: linear-gradient(135deg, #8c1d1d, #571010);
    box-shadow: 0 2px 8px rgba(140, 29, 29, 0.5);
  }
  .post-loading-circle {
    width: 140px;
    height: 140px;
    border: 3px solid rgba(140, 29, 29, 0.2);
    border-top: 3px solid #8c1d1d;
    border-right: 3px solid #b32424;
    border-radius: 50%;
    animation: spinRune 1.8s linear infinite;
    box-shadow: 0 0 25px rgba(140, 29, 29, 0.6);
    position: absolute;
  }

  @keyframes spinRune {
    0% { transform: rotate(0deg) scale(1); }
    50% { transform: rotate(180deg) scale(1.08); box-shadow: 0 0 35px rgba(179, 36, 36, 0.9); }
    100% { transform: rotate(360deg) scale(1); }
  }
</style>

<script>
  (function() {
    let loadingInterval = null;

    function setupModeToggle() {
      const modeAi = document.getElementById("mode-ai");
      const modeManual = document.getElementById("mode-manual");
      const tabAi = document.getElementById("tab-ai");
      const tabManual = document.getElementById("tab-manual");
      const aiGroup = document.getElementById("ai-input-group");
      const manualGroup = document.getElementById("manual-input-group");
      const aiTextarea = document.getElementById("ai-error-textarea");
      const manualTankaInput = document.getElementById("manual-tanka-input");
      const manualErrorTextarea = document.getElementById("manual-error-textarea");

      if (!modeAi || !modeManual) return;

      modeAi.addEventListener("change", function() {
        if (this.checked) {
          tabAi.classList.add("active");
          tabManual.classList.remove("active");
          aiGroup.style.display = "block";
          manualGroup.style.display = "none";

          aiTextarea.required = true;
          manualTankaInput.required = false;

          manualErrorTextarea.removeAttribute("name");
          aiTextarea.setAttribute("name", "post[error_message]");
        }
      });

      modeManual.addEventListener("change", function() {
        if (this.checked) {
          tabManual.classList.add("active");
          tabAi.classList.remove("active");
          manualGroup.style.display = "block";
          aiGroup.style.display = "none";

          aiTextarea.required = false;
          manualTankaInput.required = true;

          aiTextarea.removeAttribute("name");
          manualErrorTextarea.setAttribute("name", "post[error_message]");
        }
      });
    }

    function setupPostLoading() {
      const btn = document.getElementById("tanka-submit-btn");
      const overlay = document.getElementById("post-loading-overlay");
      const textEl = document.getElementById("post-loading-text");
      const modeAi = document.getElementById("mode-ai");

      if (!btn || !overlay) return;

      if (btn.dataset.loadingBound) return;
      btn.dataset.loadingBound = "true";

      btn.addEventListener("click", function(e) {
        if (modeAi && !modeAi.checked) {
          overlay.style.display = "flex";
          if (textEl) textEl.textContent = "短歌を記録しております…";
          return;
        }

        const aiTextarea = document.getElementById("ai-error-textarea");
        if (aiTextarea && !aiTextarea.value.trim()) return;

        overlay.style.display = "flex";

        const messages = [
          "バグの怨念を集めております…",
          "深層ログを紐解き中…",
          "絶望の歌を詠み上げております…",
          "構文エラーの呪いを編み込み中…",
          "スタックトレースを解読中…"
        ];
        let idx = 0;

        if (loadingInterval) clearInterval(loadingInterval);

        loadingInterval = setInterval(() => {
          idx = (idx + 1) % messages.length;
          if (textEl) textEl.textContent = messages[idx];
        }, 2000);
      });
    }

    function initAll() {
      setupModeToggle();
      setupPostLoading();
    }

    document.addEventListener("DOMContentLoaded", initAll);
    document.addEventListener("turbo:load", initAll);
  })();
</script>
