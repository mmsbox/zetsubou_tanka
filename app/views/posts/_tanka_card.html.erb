<%= link_to post_path(post), style: "text-decoration: none; color: inherit; flex-shrink: 0;" do %>
  <div style="
    width: 180px;
    height: 480px;
    background: #faf6ed;
    border: 2px solid #d4c5b0;
    border-radius: 8px;
    padding: 24px 16px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    position: relative;
    box-sizing: border-box;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  " onmouseover="this.style.transform='translateY(-6px)'; this.style.boxShadow='0 10px 20px rgba(0,0,0,0.15)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 15px rgba(0,0,0,0.1)';" >

    <!-- 上部の飾り穴 -->
    <div style="width: 12px; height: 12px; border-radius: 50%; background: #333; margin-bottom: 16px;"></div>

    <!-- 縦書き短歌テキスト -->
    <div style="
      writing-mode: vertical-rl;
      text-orientation: upright;
      font-family: 'Shippori Mincho', 'Yu Mincho', serif;
      font-size: 16px;
      line-height: 2.0;
      letter-spacing: 0.12em;
      color: #2b2b2b;
      height: 330px;
      overflow: hidden;
    ">
      <%= post.tanka.presence || "（短歌生成中…）" %>
    </div>

    <!-- 下部の詠み手（雅号） -->
    <div style="
      writing-mode: vertical-rl;
      text-orientation: upright;
      font-family: 'Shippori Mincho', 'Yu Mincho', serif;
      font-size: 13px;
      color: #7d1c1c;
      align-self: flex-start;
      margin-top: auto;
    ">
      <%= post.author_name.presence || "名無し法師" %>
    </div>

  </div>
<% end %>
