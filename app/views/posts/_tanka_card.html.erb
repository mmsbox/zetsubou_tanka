<div style="
  width: 260px;
  background: #faf6ed;
  border: 2px solid #d4c5b0;
  border-radius: 12px;
  padding: 24px 16px;
  box-shadow: 0 8px 20px rgba(0,0,0,0.12);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  min-height: 420px;
  font-family: 'Shippori Mincho', serif;
  box-sizing: border-box;
">
  <!-- 短歌縦書き表示エリア -->
  <div style="
    writing-mode: vertical-rl;
    text-orientation: upright;
    font-size: 18px;
    line-height: 2.0;
    letter-spacing: 3px;
    color: #2d3748;
    height: 280px;
    display: flex;
    justify-content: center;
    align-items: center;
  ">
    <%= post.tanka %>
  </div>

  <!-- 詠み手情報 -->
  <div style="width: 100%; text-align: right; font-size: 13px; color: #718096; margin-top: 12px;">
    詠み手：<%= post.author_name.presence || "名無し法師" %>
  </div>

  <!-- 共感（いいね）ボタン -->
  <div style="margin-top: 16px; width: 100%; text-align: center;">
    <button type="button" class="gallery-like-btn" data-post-id="<%= post.id %>" style="
      padding: 8px 18px;
      background: #ffffff;
      border: 1px solid #d4c5b0;
      border-radius: 20px;
      cursor: pointer;
      font-family: 'Shippori Mincho', serif;
      font-size: 14px;
      font-weight: bold;
      color: #333;
      box-shadow: 0 2px 6px rgba(0,0,0,0.05);
      transition: transform 0.1s ease;
    ">
      🔥 共感 <span class="like-count-<%= post.id %>" style="color: #8c1d1d; margin-left: 4px;"><%= post.likes_count || 0 %></span>
    </button>
  </div>
</div>
